{
  "name": "zip",
  "displayName": "Zip",
  "description": "Create, preview, edit, and extract zip-based files.",
  "version": "0.2.3",
  "publisher": "oub",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/oub/vscode-extension-zip"
  },
  "homepage": "https://github.com/oub/vscode-extension-zip",
  "bugs": {
    "url": "https://github.com/oub/vscode-extension-zip/issues"
  },
  "engines": {
    "vscode": "^1.109.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "keywords": [
    "zip",
    "unzip",
    "editor",
    "archive",
    "zip-based"
  ],
  "activationEvents": [
    "onFileSystem:zip",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "Zip",
      "properties": {
        "zip.fileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".zip",
            ".vsix"
          ],
          "scope": "window",
          "markdownDescription": "File extensions that are treated as zip archives by the Explorer context menu and the file dialogs.\n\nClicking one of those files opens it in the Zip Explorer instead of a regular editor. This keeps an entry per extension in `#workbench.editorAssociations#` in your user settings, which is removed again when the extension is uninstalled."
        },
        "zip.archives.defaultOpenMode": {
          "type": "string",
          "enum": [
            "read-only",
            "editable"
          ],
          "enumDescriptions": [
            "Archives are protected against accidental changes. Their entries cannot be added, renamed, moved, deleted, or saved.",
            "Archives and their entries can be modified right away."
          ],
          "default": "read-only",
          "scope": "window",
          "markdownDescription": "Whether archives opened in the Zip view can be modified. The mode of an already open archive can be changed at any time with **Make Read-only** and **Make Read-write**, and is remembered when the workspace is reopened."
        },
        "zip.actions.zip.removeTopLevelFolder": {
          "type": "string",
          "enum": [
            "no",
            "yes"
          ],
          "enumDescriptions": [
            "Keep the single top-level folder as the root inside the Zip file.",
            "Zip the contents of the single top-level folder directly, without the folder itself."
          ],
          "default": "no",
          "scope": "window",
          "markdownDescription": "When zipping a single folder, whether to remove that folder itself and zip its contents directly. For example, zipping a folder `project` containing `file.txt` produces `project/file.txt` inside the Zip when `no`, or just `file.txt` when `yes`."
        },
        "zip.actions.unzip.addFileNameToPath": {
          "type": "string",
          "enum": [
            "no",
            "yes"
          ],
          "enumDescriptions": [
            "Unzip directly into the selected folder.",
            "Unzip into a new subfolder named after the archive."
          ],
          "default": "no",
          "scope": "window",
          "markdownDescription": "Add file name to path when unzipping. For example, unzipping `archive.zip` into `/target` extracts to `/target` when `no`, or `/target/archive` when `yes`."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "zip.redirectToTree",
        "displayName": "Zip redirection...",
        "priority": "default",
        "selector": [
          {
            "filenamePattern": "*.zip"
          }
        ]
      }
    ],
    "resourceLabelFormatters": [
      {
        "scheme": "zip",
        "formatting": {
          "label": "${path}",
          "separator": "/",
          "stripPathStartingSeparator": true
        }
      }
    ],
    "commands": [
      {
        "command": "zip.zip",
        "title": "Zip...",
        "category": "Zip"
      },
      {
        "command": "zip.zip.files",
        "title": "Zip Files...",
        "category": "Zip"
      },
      {
        "command": "zip.zip.file",
        "title": "Zip File...",
        "category": "Zip"
      },
      {
        "command": "zip.zip.folders",
        "title": "Zip Folders...",
        "category": "Zip"
      },
      {
        "command": "zip.zip.folder",
        "title": "Zip Folder...",
        "category": "Zip"
      },
      {
        "command": "zip.unzip",
        "title": "Unzip...",
        "category": "Zip"
      },
      {
        "command": "zip.unzip.file",
        "title": "Unzip Archive...",
        "category": "Zip"
      },
      {
        "command": "zip.open",
        "title": "Open in Zip Explorer",
        "category": "Zip"
      },
      {
        "command": "zip.open.file",
        "title": "Open Zip Archive...",
        "category": "Zip",
        "icon": "$(folder-opened)"
      },
      {
        "command": "zip.openContainingZip",
        "title": "Go to Containing Zip Archive",
        "category": "Zip",
        "icon": "$(file-zip)",
        "enablement": "resourceScheme === 'zip'"
      },
      {
        "command": "zip.view.refresh",
        "title": "Reload",
        "category": "Zip",
        "icon": "$(refresh)"
      },
      {
        "command": "zip.openSettings",
        "title": "Open Settings",
        "category": "Zip",
        "icon": "$(gear)"
      },
      {
        "command": "zip.view.close",
        "title": "Close",
        "category": "Zip",
        "icon": "$(close)"
      },
      {
        "command": "zip.view.pin",
        "title": "Pin",
        "category": "Zip",
        "icon": "$(pin)"
      },
      {
        "command": "zip.view.unpin",
        "title": "Unpin",
        "category": "Zip",
        "icon": "$(pinned)"
      },
      {
        "command": "zip.view.unzip",
        "title": "Unzip...",
        "category": "Zip",
        "icon": "$(archive)"
      },
      {
        "command": "zip.view.newFile",
        "title": "New File...",
        "category": "Zip",
        "icon": "$(new-file)"
      },
      {
        "command": "zip.view.newFolder",
        "title": "New Folder...",
        "category": "Zip",
        "icon": "$(new-folder)"
      },
      {
        "command": "zip.view.rename",
        "title": "Rename or Move...",
        "category": "Zip",
        "icon": "$(rename)"
      },
      {
        "command": "zip.view.delete",
        "title": "Delete",
        "category": "Zip",
        "icon": "$(trash)"
      },
      {
        "command": "zip.view.enableReadOnly",
        "title": "Make Read-only",
        "category": "Zip",
        "icon": "$(unlock)"
      },
      {
        "command": "zip.view.disableReadOnly",
        "title": "Make Read-write",
        "category": "Zip",
        "icon": "$(lock)"
      }
    ],
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "zip-view-container",
          "title": "Zip",
          "icon": "$(file-zip)"
        }
      ]
    },
    "views": {
      "zip-view-container": [
        {
          "id": "zip.explorer",
          "name": "Zip",
          "icon": "$(file-zip)",
          "contextualTitle": "Zip"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "zip.zip",
          "when": "false"
        },
        {
          "command": "zip.zip.files",
          "when": "!config.files.simpleDialog.enable"
        },
        {
          "command": "zip.zip.file",
          "when": "config.files.simpleDialog.enable"
        },
        {
          "command": "zip.zip.folders",
          "when": "!config.files.simpleDialog.enable"
        },
        {
          "command": "zip.zip.folder",
          "when": "config.files.simpleDialog.enable"
        },
        {
          "command": "zip.unzip",
          "when": "false"
        },
        {
          "command": "zip.open",
          "when": "false"
        },
        {
          "command": "zip.view.close",
          "when": "false"
        },
        {
          "command": "zip.view.pin",
          "when": "false"
        },
        {
          "command": "zip.view.unpin",
          "when": "false"
        },
        {
          "command": "zip.view.enableReadOnly",
          "when": "false"
        },
        {
          "command": "zip.view.disableReadOnly",
          "when": "false"
        },
        {
          "command": "zip.view.unzip",
          "when": "false"
        },
        {
          "command": "zip.view.newFile",
          "when": "false"
        },
        {
          "command": "zip.view.newFolder",
          "when": "false"
        },
        {
          "command": "zip.view.rename",
          "when": "false"
        },
        {
          "command": "zip.view.delete",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "zip.open",
          "group": "navigation@40",
          "when": "resourceExtname in zip.fileExtensions"
        },
        {
          "command": "zip.zip",
          "group": "7_modification",
          "when": "(resourceScheme == file || resourceScheme == vscode-remote) && !(resourceExtname in zip.fileExtensions)"
        },
        {
          "command": "zip.unzip",
          "group": "7_modification",
          "when": "resourceExtname in zip.fileExtensions"
        }
      ],
      "editor/title": [
        {
          "command": "zip.openContainingZip",
          "group": "navigation",
          "when": "resourceScheme == zip"
        }
      ],
      "editor/title/context": [
        {
          "command": "zip.openContainingZip",
          "group": "2_files",
          "when": "resourceScheme == zip"
        }
      ],
      "view/title": [
        {
          "command": "zip.open.file",
          "group": "navigation@1",
          "when": "view == zip.explorer"
        },
        {
          "command": "zip.view.refresh",
          "group": "navigation@2",
          "when": "view == zip.explorer"
        },
        {
          "command": "zip.openSettings",
          "group": "9_settings",
          "when": "view == zip.explorer"
        }
      ],
      "view/item/context": [
        {
          "command": "zip.view.pin",
          "group": "inline@1",
          "when": "view == zip.explorer && viewItem =~ /^zipRootUnpinned/"
        },
        {
          "command": "zip.view.unpin",
          "group": "inline@1",
          "when": "view == zip.explorer && viewItem =~ /^zipRootPinned/"
        },
        {
          "command": "zip.view.close",
          "group": "inline@2",
          "when": "view == zip.explorer && viewItem =~ /^zipRoot/"
        },
        {
          "command": "zip.view.pin",
          "group": "1_pin@1",
          "when": "view == zip.explorer && viewItem =~ /^zipRootUnpinned/"
        },
        {
          "command": "zip.view.unpin",
          "group": "1_pin@1",
          "when": "view == zip.explorer && viewItem =~ /^zipRootPinned/"
        },
        {
          "command": "zip.view.close",
          "group": "1_pin@2",
          "when": "view == zip.explorer && viewItem =~ /^zipRoot/"
        },
        {
          "command": "zip.view.enableReadOnly",
          "group": "0_lock",
          "when": "view == zip.explorer && viewItem =~ /^zipRoot(Pinned|Unpinned)Editable$/"
        },
        {
          "command": "zip.view.disableReadOnly",
          "group": "0_lock",
          "when": "view == zip.explorer && viewItem =~ /^zipRoot(Pinned|Unpinned)ReadOnly$/"
        },
        {
          "command": "zip.view.newFile",
          "group": "1_create@1",
          "when": "view == zip.explorer && viewItem =~ /^zip(Root(Pinned|Unpinned)Editable|FolderEditable)$/"
        },
        {
          "command": "zip.view.newFolder",
          "group": "1_create@2",
          "when": "view == zip.explorer && viewItem =~ /^zip(Root(Pinned|Unpinned)Editable|FolderEditable)$/"
        },
        {
          "command": "zip.view.unzip",
          "group": "9_unzip",
          "when": "view == zip.explorer"
        },
        {
          "command": "zip.view.rename",
          "group": "3_modification@1",
          "when": "view == zip.explorer && viewItem =~ /^zip(Folder|File)Editable$/"
        },
        {
          "command": "zip.view.delete",
          "group": "3_modification@2",
          "when": "view == zip.explorer && viewItem =~ /^zip(Folder|File)Editable$/"
        }
      ]
    }
  },
  "capabilities": {
    "virtualWorkspaces": true
  },
  "scripts": {
    "vscode:prepublish": "pnpm run compile",
    "vscode:uninstall": "node ./out/uninstall.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "dependencies": {
    "adm-zip": "^0.6.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "1.109.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
